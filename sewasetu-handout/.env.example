# .env.example — Sewa Setu deployment environment variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env file to Git.

# ─── Application ───────────────────────────────────────────────────────────
# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Set to 1 when deployed behind HTTPS (recommended in production)
SESSION_COOKIE_SECURE=0

# ─── Database ───────────────────────────────────────────────────────────────
# Overrides values in app/config/app.ini when set.
# In Docker Compose these are set via docker-compose.yml environment or --env-file.
POSTGRES_DB=sewasetu
POSTGRES_USER=sewasetu
POSTGRES_PASSWORD=replace-with-strong-password

# ─── Admin ──────────────────────────────────────────────────────────────────
# Admin panel credentials (currently hardcoded in app.py — see deployment docs
# for instructions on moving these to environment variables in a future release).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-strong-password

# ─── Notes ──────────────────────────────────────────────────────────────────
# The SMS gateway URL is configured in app/config/app.ini (sms_gateway_url).
# The upload directory is configured in app/config/app.ini (upload_dir).
